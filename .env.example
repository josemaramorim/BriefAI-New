# Environment example for BriefAI MVP
# Copy to .env and fill with real credentials. Do NOT commit real secrets.

# Database
DATABASE_URL=postgresql://username:password@host:5432/dbname?schema=public

# App
PORT=3000
JWT_SECRET=replace_this_with_a_strong_secret
JWT_EXPIRES_IN=3600

# Redis (optional, for queues/sessions)
REDIS_URL=redis://localhost:6379

# Webhook retry settings
WEBHOOK_MAX_RETRIES=3

# PDF generation
PUPPETEER_CHROMIUM_PATH=

# Optional sentry
SENTRY_DSN=
