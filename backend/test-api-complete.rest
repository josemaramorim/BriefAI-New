###

### Create template (Admin ou Editor)
POST http://localhost:3001/templates
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "tenantId": "TENANT_A_ID_AQUI",
  "name": "Template Lançamento Produto SaaS",
  "description": "Template para briefing de lançamento de produtos SaaS",
  "blocks": [
    {
      "title": "Contexto",
      "order": 0,
      "questions": [
        {
          "text": "Qual é o objetivo principal?",
          "type": "select",
          "required": true
        },
        {
          "text": "Descreva o produto",
          "type": "textarea",
          "required": true
        }
      ]
    },
    {
      "title": "Modelo de Negócio",
      "order": 1,
      "questions": [
        {
          "text": "Qual modelo de negócio?",
          "type": "select",
          "required": true
        }
      ]
    },
    {
      "title": "Planos",
      "order": 2,
      "parentId": null,
      "questions": [
        {
          "text": "Quantos planos?",
          "type": "number",
          "required": false
        }
      ]
    }
  ],
  "rules": [
    {
      "expression": "{\"questionId\": \"Q_MODELO\", \"operator\": \"=\", \"value\": \"Assinatura\"}",
      "action": "{\"type\": \"activate_block\", \"blockId\": \"B_PLANOS\"}"
    },
    {
      "expression": "{\"questionId\": \"Q_OBJETIVO\", \"operator\": \"=\", \"value\": \"Redução de custos\"}",
      "action": "{\"type\": \"skip_question\", \"questionId\": \"Q_X\"}"
    },
    {
      "expression": "{\"questionId\": \"Q_ORCAMENTO\", \"operator\": \"<\", \"value\": 1000}",
      "action": "{\"type\": \"set_metadata\", \"key\": \"risco\", \"value\": \"baixo\"}"
    }
  ]
}

# Copie o templateId retornado para usar nas próximas requisições

