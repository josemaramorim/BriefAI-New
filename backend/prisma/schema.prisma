generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  templates Template[]

  @@map("tenants")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("Respondente") // Admin, Editor, Respondente
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  briefInstances  BriefInstance[]

  @@map("users")
}

model Template {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  // If true, clients may start answering drafts (not yet published). When enabled,
  // the system creates a TemplateVersion snapshot at start time so responses are
  // tied to a stable version.
  allowDraftResponses Boolean @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  blocks    Block[]
  rules     Rule[]
  versions  TemplateVersion[]
  instances BriefInstance[]

  @@map("templates")
}

model Block {
  id         String   @id @default(cuid())
  templateId String
  // Human-editable key used for rule references. Generated from title when missing.
  key        String?
  title      String
  description String?  // Objetivo ou descrição do bloco
  order      Int      @default(0)
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template  Template   @relation(fields: [templateId], references: [id])
  parent    Block?     @relation("SubBlocks", fields: [parentId], references: [id])
  children  Block[]    @relation("SubBlocks")
  questions Question[]

  @@unique([templateId, key])
  @@map("blocks")
}

model Question {
  id        String   @id @default(cuid())
  blockId   String
  // Human-editable key used for rule references and imports. Generated from text when missing.
  key       String? 
  text      String
  type      String   @default("text") // text, textarea, number, select, multiselect, image_choice
  required  Boolean  @default(false)
  placeholder String?  // Texto de ajuda no campo
  options   Json?    // for select/multiselect types
  imageOptions Json? // [{ url: string, label?: string }] // Links das imagens para opções de escolha
  imageChoiceConfig Json? // { multiple: boolean } // Define se a seleção é única ou múltipla
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  block     Block      @relation(fields: [blockId], references: [id])
  responses Response[]

  @@unique([blockId, key])
  @@map("questions")
}

model Rule {
  id         String   @id @default(cuid())
  templateId String
  expression String   // JSON or simple expression like "question_id = value"
  action     String   // JSON describing action: activate_block, skip_question, end_brief
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template Template @relation(fields: [templateId], references: [id])

  @@map("rules")
}

model TemplateVersion {
  id         String   @id @default(cuid())
  templateId String
  data       Json     // snapshot of template + blocks + questions + rules
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id])
  instances BriefInstance[]

  @@map("template_versions")
}

model BriefInstance {
  id         String   @id @default(cuid())
  templateId String
  versionId  String?
  userId     String?
  tenantId   String
  status     String   @default("draft") // draft, completed
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template  Template   @relation(fields: [templateId], references: [id])
  version   TemplateVersion? @relation(fields: [versionId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
  responses Response[]

  @@map("brief_instances")
}

model Response {
  id        String   @id @default(cuid())
  briefId   String
  questionId String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brief    BriefInstance @relation(fields: [briefId], references: [id])
  question Question      @relation(fields: [questionId], references: [id])

  @@unique([briefId, questionId])
  @@map("responses")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  userName  String?  // Nome do usuário para registro histórico rápido
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
